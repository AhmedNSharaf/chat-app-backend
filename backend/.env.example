# 🌐 Server Configuration
PORT=3000

# 🔐 JWT Secret Key (Use a secure, unique key in production)
# Generate a secure key using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here

# 🍃 MongoDB Connection
# For local development:
MONGODB_URI=mongodb://localhost:27017/chat_app

# For production (MongoDB Atlas):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/chat_app?retryWrites=true&w=majority

# 🏭 Environment
NODE_ENV=development
